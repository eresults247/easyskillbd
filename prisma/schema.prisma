datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")echo }

generator client {
  provider = "prisma-client-js"
}

model Course {
  id          String   @id @default(uuid())echo   title       String
  slug        String   @unique
  category    String
  price       Float
  instructor  String   @default("EasySkillBD")echo   youtubeUrl  String
  description String
  createdAt   DateTime @default(now())echo }
